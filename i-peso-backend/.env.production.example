APP_NAME="i-PESO Urdaneta City"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=i_peso
DB_USERNAME=i_peso
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=example.com,api.example.com
SANCTUM_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=ipeso_

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
EMPLOYER_DOCUMENTS_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Official PSA Classification API token for PSOC catalog synchronization.
PSOC_API_TOKEN=
PSOC_API_BASE_URL=https://classification.psa.gov.ph/psoc

# Google OAuth client for the employer Interview Calendar / Meet link feature.
# Create a Web application OAuth client in Google Cloud Console with the
# Calendar API enabled, and register the redirect URI below as an authorized
# redirect URI. Each employer authorizes their OWN calendar — do not add a
# GOOGLE_CALENDAR_ID override; the service always targets "primary".
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALENDAR_REDIRECT_URI=https://api.example.com/api/employer/calendar/callback

# Google Maps Platform server key. Restrict it by production server IP.
GOOGLE_MAPS_SERVER_API_KEY=CHANGE_ME
GOOGLE_MAPS_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_MAPS_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode
GOOGLE_MAPS_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_MAPS_COUNTRY_CODE=PH
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_ROUTES_ENABLED=false

# Optional: only needed if Expo's "Enhanced Security" push mode is enabled
# on the mobile app's EAS project. Push notifications work without it.
EXPO_ACCESS_TOKEN=

# Vertex AI / Gemini suggestions for seeker occupation and skills assistance.
# The production server should use its attached service account rather than
# a downloaded JSON key — leave GOOGLE_APPLICATION_CREDENTIALS unset in that
# case and only set GOOGLE_CLOUD_PROJECT_ID / GOOGLE_CLOUD_LOCATION.
GOOGLE_VERTEX_AI_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=CHANGE_ME
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VERTEX_AI_MODEL=gemini-3.1-flash-lite
GOOGLE_VERTEX_AI_TIMEOUT=20

# JobDataLake server-side credentials for occupation title discovery.
JOB_DATA_LAKE_API_KEY=CHANGE_ME
JOB_DATA_LAKE_BASE_URL=https://api.jobdatalake.com

# SMS gateway. Defaults to log-only (no real SMS sent) until deliberately
# switched on — set SMS_LOG_ONLY=false and supply real UniSMS credentials
# once the office is ready to send live SMS notifications.
SMS_DRIVER=log_only
SMS_PROVIDER=unisms
SMS_API_BASE_URL=https://unismsapi.com/api
UNISMS_SECRET_KEY=CHANGE_ME
UNISMS_SENDER_ID=CHANGE_ME
SMS_DEFAULT_COUNTRY=PH
SMS_LOG_ONLY=true
SMS_TIMEOUT=10

# Google AI Studio key for the public i-PESO assistant: https://aistudio.google.com
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=20
