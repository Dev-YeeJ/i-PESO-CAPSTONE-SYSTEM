APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost,127.0.0.1
SANCTUM_EXPIRATION=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
EMPLOYER_DOCUMENTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Official PSA Classification API token for `php artisan occupations:sync-psoc`
PSOC_API_TOKEN=
PSOC_API_BASE_URL=https://classification.psa.gov.ph/psoc

# Google Maps Platform server key. Restrict it by server IP and allow only
# Places API (New), Geocoding API, and Routes API when routes are enabled.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_MAPS_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode
GOOGLE_MAPS_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_MAPS_COUNTRY_CODE=PH
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_ROUTES_ENABLED=false

# Vertex AI / Gemini suggestions for seeker occupation and skills assistance.
# Local development can use `gcloud auth application-default login`; Cloud Run
# should use the attached service account instead of a downloaded JSON key.
GOOGLE_VERTEX_AI_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=project-7c2a45e1-23fd-41ae-a42
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VERTEX_AI_MODEL=gemini-2.5-flash
GOOGLE_VERTEX_AI_TIMEOUT=20

# JobDataLake server-side credentials for occupation title discovery.
JOB_DATA_LAKE_API_KEY=
JOB_DATA_LAKE_BASE_URL=https://api.jobdatalake.com
