VITE_API_BASE_URL=https://api.example.com/api
VITE_GOOGLE_MAPS_EMBED_API_KEY=your_referrer_restricted_google_maps_embed_key
VITE_GOOGLE_MAPS_MAP_ID=your_google_cloud_map_id

# Optional — all have safe fallbacks if left unset.
# Overrides the app icon derived from VITE_API_BASE_URL.
# VITE_IPESO_LOGO_URL=
# 'leaflet' (default, no key needed) or 'google' to prefer the Google Maps
# provider on job-vacancy maps.
# VITE_JOB_MAP_PROVIDER=leaflet
# Laravel Reverb (websockets) — live features stay off until VITE_REVERB_APP_KEY
# is set; no other Reverb var takes effect without it.
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=https
