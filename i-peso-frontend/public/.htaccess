<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html must always be revalidated — it's what points browsers at the
  # current build's hashed JS/CSS filenames. Without this, a browser (or a
  # proxy in front of it) can keep serving an old index.html past a deploy
  # with no error, since the old hashed assets it references still exist.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Vite content-hashes these filenames on every build, so a changed file
  # always gets a new URL — safe to cache indefinitely.
  <FilesMatch "-[A-Za-z0-9_]{6,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
